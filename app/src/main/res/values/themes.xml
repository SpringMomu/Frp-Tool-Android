<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FrpManager.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/app_on_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_variant</item>
        <item name="colorError">@color/error_color</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/toolbar_surface</item>
        <item name="android:statusBarColor">@color/toolbar_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/Widget.FrpManager.Card</item>
        <item name="materialButtonStyle">@style/Widget.FrpManager.Button</item>
        <item name="textInputStyle">@style/Widget.FrpManager.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.FrpManager.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FrpManager.MaterialAlertDialog</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FrpManager.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FrpManager.Medium</item>
        <item name="colorPendingBackground">@color/pending_changes_background</item>
        <item name="colorWarning">@color/status_pending</item>
    </style>

    <style name="Theme.FrpManager" parent="Theme.FrpManager.Base" />

    <style name="Widget.FrpManager.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/dashboard_card</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FrpManager.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.FrpManager.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <style name="Widget.FrpManager.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/toolbar_surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.FrpManager.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.FrpManager.ToolbarSubtitle</item>
    </style>

    <style name="TextAppearance.FrpManager.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.FrpManager.ToolbarSubtitle" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/app_on_surface_variant</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.FrpManager.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/press_start_2p_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.FrpManager.Stat" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/press_start_2p_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeAppearance.FrpManager.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.FrpManager.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ThemeOverlay.FrpManager.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">6dp</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FrpManager.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlayFrpManagerDialog</item>
    </style>

    <style name="ShapeAppearance.FrpManager.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearanceOverlayFrpManagerDialog">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>
