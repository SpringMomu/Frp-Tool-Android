<?xml version="1.0" encoding="utf-8"?>
<io.momu.frpmanager.AnimatedGridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".FrpManagerActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_surface"
            android:elevation="0dp"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_manager"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:subtitle="FRP ENDPOINTS"
                app:title="端口矩阵" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/manager_sync_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackThickness="3dp" />
        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_status"
                style="@style/Widget.MaterialComponents.Chip.Entry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:clickable="false"
                android:focusable="false"
                android:text="筛选中"
                android:visibility="gone"
                app:chipIcon="@drawable/outline_filter_alt_24"
                app:closeIconVisible="true"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/background_filter_panel"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/filter_header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/icon_filter"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/outline_filter_alt_24"
                        app:tint="@color/brand_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/icon_filter"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="组合筛选"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="状态 / 协议 / 防火墙"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/app_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_toggle_filters"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="展开筛选选项"
                        android:src="@drawable/outline_arrow_drop_down_24"
                        app:tint="@color/app_on_surface_variant" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/filters_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="运行状态"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/app_on_surface_variant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_status_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_all"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="全部" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_running"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="运行中" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_stopped"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已停止" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="传输协议"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/app_on_surface_variant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_protocol_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_protocol_all"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="全部" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_protocol_tcp"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TCP" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_protocol_udp"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UDP" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="防火墙"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/app_on_surface_variant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_firewall_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_firewall_all"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="全部" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_firewall_allowed"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已放行" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_filter_firewall_blocked"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未放行" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_ports"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="8dp"
                    android:paddingBottom="96dp"
                    tools:listitem="@layout/list_item_frp_profile" />

                <TextView
                    android:id="@+id/empty_view_text"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="暂无端口映射"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/app_on_surface_variant"
                    android:visibility="gone"
                    app:drawableTopCompat="@drawable/outline_electrical_services_24"
                    app:drawableTint="@color/app_on_surface_variant"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/batch_actions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/background_batch_panel"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_selection"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="取消" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="批量操作"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_delete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="删除"
                    android:textColor="?attr/colorError" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_batch_start"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="启动" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_batch_stop"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="暂停" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_batch_firewall_allow"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="放行" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_batch_firewall_block"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="阻止" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_port"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="添加端口映射"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/brand_primary"
            app:tint="@color/brand_on_primary" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</io.momu.frpmanager.AnimatedGridLayout>
