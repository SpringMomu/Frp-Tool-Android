<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/background_chip">

            <ImageView
                android:id="@+id/log_header_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/outline_assignment_24"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/log_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信息详情"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/app_on_surface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log_status_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="内容可选择并复制"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/app_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/log_progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackThickness="4dp" />

    <ScrollView
        android:id="@+id/log_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/background_info_panel"
        android:clipToOutline="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/log_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/log_timeline_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/app_on_surface"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:text="服务器信息将在这里显示" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copy_log"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:text="复制内容"
        app:icon="@drawable/outline_assignment_24" />
</LinearLayout>
