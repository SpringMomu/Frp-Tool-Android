<?xml version="1.0" encoding="utf-8"?>
<io.momu.frpmanager.AnimatedGridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_surface"
            android:elevation="0dp"
            app:elevation="0dp"
            app:liftOnScroll="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="8dp"
                app:subtitle="SERVER DASHBOARD"
                app:title="FRP 控制台" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/sync_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackThickness="3dp" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboard_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/dashboard_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_server_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_electrical_services_24"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="服务器遥测"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_dashboard_state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="WAITING"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/status_pending"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="132dp"
                                android:orientation="vertical"
                                android:paddingStart="0dp"
                                android:paddingEnd="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CPU"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="@color/app_on_surface_variant" />

                                <TextView
                                    android:id="@+id/tv_cpu_usage"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:autoSizeMaxTextSize="24sp"
                                    android:autoSizeMinTextSize="17sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:fontFamily="@font/press_start_2p_regular"
                                    android:gravity="start|center_vertical"
                                    android:maxLines="1"
                                    android:text="--"
                                    android:textAppearance="@style/TextAppearance.FrpManager.Metric"
                                    tools:text="72%" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progress_cpu"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="4dp"
                                    app:indicatorColor="@color/brand_primary"
                                    app:trackColor="@color/app_surface_container_high"
                                    app:trackCornerRadius="3dp"
                                    app:trackThickness="6dp"
                                    tools:progress="72" />

                                <TextView
                                    android:id="@+id/tv_cpu_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="@color/app_on_surface_variant"
                                    tools:text="Xeon E5 / 16 Cores" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="132dp"
                                android:background="@color/app_outline_variant" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="132dp"
                                android:orientation="vertical"
                                android:paddingHorizontal="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MEM"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="@color/app_on_surface_variant" />

                                <TextView
                                    android:id="@+id/tv_memory_usage"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:autoSizeMaxTextSize="24sp"
                                    android:autoSizeMinTextSize="17sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:fontFamily="@font/press_start_2p_regular"
                                    android:gravity="start|center_vertical"
                                    android:maxLines="1"
                                    android:text="--"
                                    android:textAppearance="@style/TextAppearance.FrpManager.Metric"
                                    tools:text="48%" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progress_memory"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="4dp"
                                    app:indicatorColor="@color/brand_tertiary"
                                    app:trackColor="@color/app_surface_container_high"
                                    app:trackCornerRadius="3dp"
                                    app:trackThickness="6dp"
                                    tools:progress="48" />

                                <TextView
                                    android:id="@+id/tv_memory_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="@color/app_on_surface_variant"
                                    tools:text="7.6G / 16G" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="132dp"
                                android:background="@color/app_outline_variant" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="132dp"
                                android:orientation="vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="0dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TEMP"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="@color/app_on_surface_variant" />

                                <TextView
                                    android:id="@+id/tv_cpu_temp"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:autoSizeMaxTextSize="24sp"
                                    android:autoSizeMinTextSize="17sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:fontFamily="@font/press_start_2p_regular"
                                    android:gravity="start|center_vertical"
                                    android:maxLines="1"
                                    android:text="--"
                                    android:textAppearance="@style/TextAppearance.FrpManager.Metric"
                                    tools:text="55°C" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progress_cpu_temp"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="4dp"
                                    app:indicatorColor="@color/status_stopped"
                                    app:trackColor="@color/app_surface_container_high"
                                    app:trackCornerRadius="3dp"
                                    app:trackThickness="6dp"
                                    tools:progress="55" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="CPU PACKAGE"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="@color/app_on_surface_variant" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_disk_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/layout_disk_header"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:id="@+id/icon_disk"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_table_view_24"
                                app:tint="@color/brand_tertiary" />

                            <TextView
                                android:id="@+id/tv_disk_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@id/icon_disk"
                                android:text="存储阵列"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_disk_expand"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="展开存储详情"
                                android:rotation="0"
                                android:src="@drawable/outline_arrow_drop_down_24"
                                app:tint="@color/app_on_surface_variant" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/layout_disk_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_frp_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/outline_rocket_launch_24"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="FRP 服务矩阵"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:rowCount="2">

                            <include
                                android:id="@+id/stat_total"
                                layout="@layout/include_stat_item"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp" />

                            <include
                                android:id="@+id/stat_running"
                                layout="@layout/include_stat_item"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp" />

                            <include
                                android:id="@+id/stat_pending"
                                layout="@layout/include_stat_item"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp" />

                            <include
                                android:id="@+id/stat_error"
                                layout="@layout/include_stat_item"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp" />
                        </GridLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_apply_all"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="一键应用所有更改"
                            android:visibility="gone"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/outline_cloud_upload_24"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="快捷操作"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_enter_frp_manager"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp"
                            android:gravity="start|center_vertical"
                            android:text="进入端口管理"
                            app:icon="@drawable/outline_electrical_services_24"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_logs"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:text="服务器信息"
                                app:cornerRadius="6dp"
                                app:icon="@drawable/outline_assignment_24"
                                app:iconPadding="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_settings"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:text="SSH 设置"
                                app:cornerRadius="6dp"
                                app:icon="@drawable/outline_key_24"
                                app:iconPadding="8dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_frp_settings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="FRP 通用配置"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/outline_security_24"
                            app:iconPadding="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_repair_frp_deployment"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="修复 / 重新部署 FRP"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/outline_rocket_launch_24"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_run_diagnostics"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="运行环境诊断"
                            android:visibility="gone"
                            app:cornerRadius="6dp"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_debug_clear"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="start|center_vertical"
                            android:text="重置服务器环境 (Debug)"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</io.momu.frpmanager.AnimatedGridLayout>
