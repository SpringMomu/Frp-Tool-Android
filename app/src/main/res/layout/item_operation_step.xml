<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/background_timeline_item"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/step_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/timeline_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信息"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/status_disabled"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/app_on_surface"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
